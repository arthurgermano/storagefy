{
  "name": "storagefy",
  "version": "1.3.0",
  "description": "Framework-agnostic adapters that keep the state of Pinia, Redux, Zustand, Jotai or Svelte stores in localStorage, sessionStorage or IndexedDB — with expiration, optional encryption and sync between tabs.",
  "main": "dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@vitest/coverage-v8": "3.1.1",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.8.3",
    "jotai": "^2.12.3",
    "pinia": "^3.0.4",
    "react": "^19.2.4",
    "redux": "^5.0.1",
    "svelte": "^5.25.12",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vitest": "^3.1.1",
    "vue": "^3.5.13",
    "zustand": "^5.0.3"
  },
  "scripts": {
    "test": "vitest",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsup && tsc -p tsconfig.types.json",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurgermano/storagefy.git"
  },
  "keywords": [
    "state-management",
    "localStorage",
    "sessionStorage",
    "indexeddb",
    "pinia",
    "zustand",
    "redux",
    "jotai",
    "svelte",
    "persistence",
    "storage",
    "sync",
    "react",
    "vue",
    "adapter",
    "storagefy"
  ],
  "author": "Arthur José Germano",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arthurgermano/storagefy/issues"
  },
  "homepage": "https://arthurgermano.github.io/storagefy/",
  "dependencies": {
    "misc-helpers": "^3.0.3"
  }
}
