    .cloud {
      width: 120px;
      height: 40px;
      background: #ffffff;
      border-radius: 40px;
      position: absolute;
      top: 80px;
      left: 50%;
      transform: translateX(-50%);
      opacity: 0;
      transition: opacity 0.5s;
    }

    .cloud:before {
      content: "";
      width: 50px;
      height: 50px;
      background: #ffffff;
      border-radius: 50%;
      position: absolute;
      top: -25px;
      left: 20px;
    }

    .cloud:after {
      content: "";
      width: 30px;
      height: 30px;
      background: #ffffff;
      border-radius: 50%;
      position: absolute;
      top: -15px;
      right: 20px;
    }

    .raindrops {
      position: absolute;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 0.5s;
      left: 7.5rem;
      top: 4rem;
    }

    .raindrops:before {
      content: "";
      position: absolute;
      width: 2px;
      height: 10px;
      background: #a5c8e4;
      top: 50px;
      left: 25%;
      animation: rain 1s linear infinite;
    }

    .raindrops:after {
      content: "";
      position: absolute;
      width: 2px;
      height: 10px;
      background: #a5c8e4;
      top: 30px;
      left: 35%;
      animation: rain 1s linear infinite 0.3s;
    }

    @keyframes rain {
      0% {
        transform: translateY(0);
      }
      100% {
        transform: translateY(200px);
      }
    }

    .ground {
      height: 100px;
      background: linear-gradient(to bottom, #5d8b5a, #3b5e48);
      border-radius: 0 0 8px 8px;
    }

    .controls {
      display: flex;
      gap: 10px;
      margin-top: 20px;
      justify-content: center;
    }

    .strf-button {
      background-color: #703ad5;
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
      transition: background-color 0.2s;
    }

    .strf-button:hover {
